# Meldrift Free Edition needs no environment variable to run. These two only enable the AI assistant.
# Both stay on the server and are never sent to the browser. Set them in the Vercel project
# settings for a deployment, or copy this file to .env.local for local development.

# Google Gemini API key. The assistant is off without it.
AI_API_KEY=

# Password that unlocks the assistant. There is no sign-in in Free Edition, so this is the only gate
# in front of an API key you pay for — make it long. Changing it locks out every browser that
# had already unlocked the assistant.
AI_PASSWORD=

# Optional. Pins the chat model; the built-in list stays as fallback.
# GEMINI_MODEL=
